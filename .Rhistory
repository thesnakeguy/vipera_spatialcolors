for (v in env_vars) {
# Find the smooth corresponding to this environmental variable
sm_idx <- which(
vapply(
m$smooth,
function(s) {
identical(s$term, v) &&
length(s$term) == 1
},
logical(1)
)
)
if (!length(sm_idx))
next
sm_name <- m$smooth[[sm_idx[1]]]$label
# Environmental variable must be numeric
if (!v %in% names(m$model))
next
x <- m$model[[v]]
if (!is.numeric(x))
next
xr <- range(x, na.rm = TRUE)
if (!all(is.finite(xr)) || diff(xr) == 0)
next
newdata <- data.frame(
stringsAsFactors = FALSE
)
# Populate every model variable
for (nm in names(m$model)) {
if (nm == v) {
newdata[[nm]] <- seq(
xr[1],
xr[2],
length.out = n
)
} else if (is.numeric(m$model[[nm]])) {
newdata[[nm]] <- median(
m$model[[nm]],
na.rm = TRUE
)
} else if (is.factor(m$model[[nm]])) {
lev <- names(
sort(
table(m$model[[nm]]),
decreasing = TRUE
)
)[1]
newdata[[nm]] <- factor(
lev,
levels = levels(m$model[[nm]])
)
} else if (is.character(m$model[[nm]])) {
lev <- names(
sort(
table(m$model[[nm]]),
decreasing = TRUE
)
)[1]
newdata[[nm]] <- lev
}
}
# Make sure longitude/latitude are present
if ("longitude" %in% names(m$model))
newdata$longitude <- median(
m$model$longitude,
na.rm = TRUE
)
if ("latitude" %in% names(m$model))
newdata$latitude <- median(
m$model$latitude,
na.rm = TRUE
)
# Predict only the selected smooth
pr <- predict(
m,
newdata = newdata,
type = "terms",
terms = sm_name,
se.fit = TRUE
)
fit <- as.numeric(pr$fit[, 1])
se  <- as.numeric(pr$se.fit[, 1])
plot_list[[length(plot_list) + 1]] <- data.frame(
trait = tr,
variable = v,
x = newdata[[v]],
fit = fit,
lower = fit - 1.96 * se,
upper = fit + 1.96 * se,
stringsAsFactors = FALSE
)
}
}
if (!length(plot_list))
stop(
"No environmental smooths could be extracted. ",
"Check that env_vars match the variables used in the GAMs."
)
plot_data <- do.call(rbind, plot_list)
rownames(plot_data) <- NULL
p <- ggplot2::ggplot(
plot_data,
ggplot2::aes(
x = x,
y = fit
)
) +
ggplot2::geom_ribbon(
ggplot2::aes(
ymin = lower,
ymax = upper
),
alpha = 0.2
) +
ggplot2::geom_line(
linewidth = 0.8
) +
ggplot2::geom_hline(
yintercept = 0,
linetype = 2,
linewidth = 0.4
) +
ggplot2::facet_grid(
rows = ggplot2::vars(variable),
cols = ggplot2::vars(trait),
scales = "free_x"
) +
ggplot2::labs(
x = "Environmental variable",
y = "Partial effect"
) +
ggplot2::theme_bw(
base_size = 11
) +
ggplot2::theme(
strip.background = ggplot2::element_rect(
fill = "white",
colour = "black"
),
strip.text = ggplot2::element_text(
face = "bold"
),
panel.grid = ggplot2::element_line(
colour = "grey90",
linewidth = 0.25
),
panel.spacing = grid::unit(
0.8,
"lines"
)
)
if (requireNamespace("svglite", quietly = TRUE)) {
ggplot2::ggsave(
filename = out_svg,
plot = p,
device = svglite::svglite,
width = 10,
height = 8,
units = "in"
)
} else {
ggplot2::ggsave(
filename = out_svg,
plot = p,
device = "svg",
width = 10,
height = 8,
units = "in"
)
}
invisible(p)
}
