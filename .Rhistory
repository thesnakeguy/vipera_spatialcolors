)
plot_environmental_smooths <- function(
models,
env_vars,
traits = names(models),
out_svg,
n = 100
) {
if (!requireNamespace("ggplot2", quietly = TRUE))
stop("Package 'ggplot2' is required.")
plot_list <- list()
for (tr in traits) {
m <- models[[tr]]
if (is.null(m))
next
md <- m$model
for (v in env_vars) {
if (!v %in% names(md))
next
if (!is.numeric(md[[v]]))
next
x <- md[[v]]
xr <- range(x, na.rm = TRUE)
if (!all(is.finite(xr)) || diff(xr) == 0)
next
sm_idx <- which(
vapply(
m$smooth,
function(s) {
length(s$term) == 1 &&
identical(s$term, v)
},
logical(1)
)
)
if (!length(sm_idx))
next
sm_name <- m$smooth[[sm_idx[1]]]$label
# Start from a real model observation
newdata <- md[1, , drop = FALSE]
# Repeat it across the prediction grid
newdata <- newdata[
rep(1, n),
,
drop = FALSE
]
rownames(newdata) <- NULL
# Vary only the environmental predictor
newdata[[v]] <- seq(
xr[1],
xr[2],
length.out = n
)
pr <- predict(
m,
newdata = newdata,
type = "terms",
terms = sm_name,
se.fit = TRUE
)
fit <- as.numeric(pr$fit[, 1])
se  <- as.numeric(pr$se.fit[, 1])
plot_list[[length(plot_list) + 1]] <- data.frame(
trait = tr,
variable = v,
x = newdata[[v]],
fit = fit,
lower = fit - 1.96 * se,
upper = fit + 1.96 * se,
stringsAsFactors = FALSE
)
}
}
if (!length(plot_list))
stop(
"No environmental smooths could be extracted. ",
"Check that env_vars match the variables used in the GAMs."
)
plot_data <- do.call(rbind, plot_list)
rownames(plot_data) <- NULL
# Make each predictor × trait combination its own facet
plot_data$panel <- interaction(
plot_data$variable,
plot_data$trait,
sep = " | ",
drop = TRUE
)
p <- ggplot2::ggplot(
plot_data,
ggplot2::aes(
x = x,
y = fit
)
) +
ggplot2::geom_ribbon(
ggplot2::aes(
ymin = lower,
ymax = upper
),
alpha = 0.2
) +
ggplot2::geom_line(
linewidth = 0.8
) +
ggplot2::geom_hline(
yintercept = 0,
linetype = 2,
linewidth = 0.4
) +
ggplot2::facet_wrap(
~ panel,
scales = "free",
ncol = length(traits)
) +
ggplot2::labs(
x = NULL,
y = "Partial effect"
) +
ggplot2::theme_bw(
base_size = 11
) +
ggplot2::theme(
strip.background = ggplot2::element_rect(
fill = "white",
colour = "black"
),
strip.text = ggplot2::element_text(
face = "bold"
),
panel.grid = ggplot2::element_line(
colour = "grey90",
linewidth = 0.25
),
legend.position = "bottom"
)
if (requireNamespace("svglite", quietly = TRUE)) {
ggplot2::ggsave(
filename = out_svg,
plot = p,
device = svglite::svglite,
width = 10,
height = 8,
units = "in"
)
} else {
ggplot2::ggsave(
filename = out_svg,
plot = p,
device = "svg",
width = 10,
height = 8,
units = "in"
)
}
invisible(p)
}
plot_environmental_smooths(
models = gam_out$models,
env_vars = continuous_vars,
traits = trait_cols,
out_svg = file.path(
out_dir,
"gam_environmental_smooths.svg"
)
)
